    "test:search": "tsx --env-file=.env scripts/test-search.ts",
    "test:e2e": "playwright test scripts/journey.spec.ts --workers=1",
    "test:agent": "tsx --env-file=.env scripts/test-agent-updates.ts"
  },
  "dependencies": {
    "@tavily/core": "0.7.14",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "openai": "7.42.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
